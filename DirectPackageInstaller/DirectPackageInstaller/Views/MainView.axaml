<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DirectPackageInstaller.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DirectPackageInstaller.Views.MainView"
             Foreground="White"
             Background="#171C2C">
  <!--The Header/Content attributes below hold the language keys, they are replaced by
      the translated text in MainView.ApplyLanguage(), the key is only the design time preview.-->

  <Design.DataContext>
    <viewModels:MainViewModel />
  </Design.DataContext>
    <Grid DragDrop.AllowDrop="True" Name="MainViewGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2" Name="MainMenu">
            <MenuItem Header="Menu.Options" Name="btnOptions">
                <MenuItem Header="Menu.ProxyDownloads" Name="btnProxyDownload">
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ProxyMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.SegmentedDownloads" Name="btnSegmentedDownload" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding SegmentedMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.TransferProgress" Name="btnTransferProgress" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ShowTransferProgress, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.ErrorLog" Name="btnErrorLog" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ShowError, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.CNLSupport" Name="btnCNLService" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding CNLService, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.DHCPServer" Name="btnDHCPService" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding DHCPService, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Menu.IPAddress" Name="btnIPAddress" Classes="NoChildFocus">
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0" Content="Menu.PSIP" Name="lblPSIP"></Label>
                        <TextBox Grid.Column="1" Text="{Binding PS4IP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0" Content="Menu.PCIP" Name="lblPCIP"></Label>
                        <TextBox Grid.Column="1" Text="{Binding PCIP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                </MenuItem>
                <MenuItem Header="Menu.Debrids" Name="btnDebrids">
                    <MenuItem Header="Menu.AllDebrid" Name="btnAllDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0" Content="Menu.APIKey" Name="lblAllDebridAPIKey"></Label>
                            <TextBox Grid.Column="1" Text="{Binding AllDebridApiKey, Mode=TwoWay}" Focusable="True"></TextBox>
                        </StackPanel>
                        <MenuItem Header="Menu.Enabled" Padding="10,10,0,10" Name="btnAllDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseAllDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Menu.RealDebrid" Name="btnRealDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0" Content="Menu.APIKey" Name="lblRealDebridAPIKey"></Label>
                            <TextBox Grid.Column="1" Text="{Binding RealDebridApiKey, Mode=TwoWay}"></TextBox>
                        </StackPanel>
                        <MenuItem Header="Menu.Enabled" Padding="10,10,0,10" Name="btnRealDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseRealDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Menu.DebridLink" Name="btnDebridLink" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Menu.APIKey" Name="lblDebridLinkAPIKey" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="150" Text="{Binding DebridLinkApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <MenuItem Header="Menu.Enabled" Padding="10,10,0,10" Name="btnDebirdLinkEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseDebridLink, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>

                <MenuItem Header="Menu.Language" Name="btnLanguage" Classes="NoChildFocus"/>
                <MenuItem Header="Menu.RestartServer" Name="btnRestartServer"/>
                <MenuItem Header="Menu.Exit" Name="btnExit"/>
            </MenuItem>
            <MenuItem Header="Menu.Packages" IsVisible="False" Name="PackagesMenu">
                <Separator></Separator>
                <MenuItem Header="Menu.InstallAll" Name="btnInstallAll"></MenuItem>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,0,0" Content="Main.URL" Name="lblURL"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding CurrentURL, Mode=TwoWay}" Name="tbURL"></TextBox>
            <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Margin="5,0,5,0" Name="btnLoad" Content="Main.Open"/>
        </Grid>


        <Grid Grid.Row="2" Grid.ColumnSpan="2" Name="PreviewGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Name="IconBox"></Image>
            <GridSplitter Name="MainGridSplitter" Grid.Column="1"></GridSplitter>

            <DataGrid Grid.Column="2" Name="PkgInfoGrid" ItemsSource="{Binding PKGParams}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Main.Param" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Main.Value" Binding="{Binding Value}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Grid.Column="0" Name="Status"/>
    </Grid>
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,-6,0,-16"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="5,0,5,0"></Setter>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        </Style>
        <Style Selector="MenuItem >> Label">
            <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>
        <Style Selector="MenuItem >> TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Width" Value="150"></Setter>
        </Style>
        <Style Selector="MenuItem.NoChildFocus > MenuItem">
            <Setter Property="Focusable" Value="False"></Setter>
            <Setter Property="StaysOpenOnClick" Value="True"></Setter>
        </Style>
        <Style Selector="MenuItem.SelectedLanguage">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF5AC8FA"/>
        </Style>
    </UserControl.Styles>
</UserControl>
